<?xml version="1.0" encoding="UTF-8"?>
<!--
  Rebuild the local A-share daily dataset every weekday at 16:00 Beijing, one
  hour after the close. launchd rather than cron: cron jobs are skipped outright
  when the machine is asleep, while launchd runs a missed StartCalendarInterval
  job as soon as the machine wakes.

  The job itself decides whether today was a trading day by asking the data, so
  running it on a public holiday costs one probe request and exits 0.

  Install:
      cp deploy/com.zhcwithyou.axdata.daily-update.plist ~/Library/LaunchAgents/
      launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.zhcwithyou.axdata.daily-update.plist
      launchctl enable gui/$(id -u)/com.zhcwithyou.axdata.daily-update

  Run it once by hand:
      launchctl kickstart -p gui/$(id -u)/com.zhcwithyou.axdata.daily-update

  Remove:
      launchctl bootout gui/$(id -u)/com.zhcwithyou.axdata.daily-update

  Paths are absolute because launchd starts with an almost empty environment and
  no working directory. Change them if the checkout moves.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.zhcwithyou.axdata.daily-update</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/harrison/Dev/trading-tools/data-server/AxData/.venv/bin/python</string>
        <string>/Users/harrison/Dev/trading-tools/data-server/AxData/scripts/daily_update.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/harrison/Dev/trading-tools/data-server/AxData</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>AXDATA_DATA_DIR</key>
        <string>/Users/harrison/Dev/trading-tools/data-server/AxData/data</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/harrison/Dev/trading-tools/data-server/AxData/logs/daily_update.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/harrison/Dev/trading-tools/data-server/AxData/logs/daily_update.err.log</string>

    <!-- A rebuild is ~7 minutes of network and CPU; do not let it fight the UI. -->
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>5</integer>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
